# ─────────────────────────────────────────────────────────────────────────────
# Non-secret shared config. SAFE TO COMMIT.
# Loaded by the Tiltfile into a ConfigMap named "app-config" and pulled into
# pods via envFrom. One source of truth for hosts, URLs, and queue names.
#
# Rule: only values that are the SAME for every service belong here.
# Per-service values (e.g. which queue a worker drains) stay inline in the
# pod spec, NOT here.
# ─────────────────────────────────────────────────────────────────────────────

# Redis
REDIS_URL=redis://redis:6379

# Queue names (the api pushes to these; workers read one each)
QUEUE_GPU=jobs:gpu
QUEUE_CPU=jobs:cpu
# Drained by a SIF worker rather than by KEDA — a compute node, or a laptop
# running services/worker-gpu/run-local-worker.sh. Kept off jobs:gpu so it does
# not race KEDA's worker-gpu ScaledJob for the same job.
QUEUE_HPC=jobs:hpc
# Post-solve KPI computation (buildings/land-use/hazard metrics). Its own
# queue so it never races jobs:cpu/jobs:gpu, and so worker-kpi can scale
# independently of the (much heavier) ANUGA workers.
QUEUE_KPI=jobs:kpi
# RQ's own default job timeout (180s) is too short once a basin's OSM data
# isn't cached yet. Read by both the enqueuer (api, worker-gpu) and could be
# used to keep k8s/keda-kpi.yaml's activeDeadlineSeconds comfortably above it.
KPI_JOB_TIMEOUT=1200

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:80

# MinIO / S3 endpoint (the URL is not secret; the credentials are — see .env)
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# HPC login node, by ordinary DNS. This used to be the bare "vrhpcadm1" served
# by the tailscale operator's egress proxy, but that node's tailscaled has been
# offline since 2026-08, so the ExternalName in k8s/api.yaml resolves to a dead
# device. The login name is per-service and stays inline in the pod spec; the
# password is secret and lives in .env as HPC_PASSWORD.
HPC_SSH_HOST=vrhpcadm1.dsic.upv.es

# ─── Public URLs ─────────────────────────────────────────────────────────────
# Everything user-facing is reached over the tailnet. These names come from the
# tailscale.com/hostname annotations in k8s/*.yaml; the operator provisions a
# real Let's Encrypt cert for each, so there is no CA to install and the same
# URL works from any tailnet member.
#
# The *.127.0.0.1.nip.io traefik ingresses are still there as a local fallback,
# but nothing is configured to use them any more. Keycloak runs with
# KC_HOSTNAME_STRICT=false, so it still answers on the nip.io host — it just
# mints tokens whose issuer is KC_PUBLIC_URL either way, which is what keeps
# the API's issuer check working over both paths.
TAILNET_DOMAIN=tail51f978.ts.net

# Token issuer. src/auth.py builds ISSUER from this, and it must match
# KC_HOSTNAME in k8s/keycloak.yaml exactly or every token is rejected.
KC_PUBLIC_URL=https://hidris-keycloak.tail51f978.ts.net

# Read by vite at dev-server start (loadEnv picks up VITE_-prefixed vars from
# the process environment, not just .env files) and inlined into the bundle.
# k8s/frontend.yaml injects them; without them the code falls back to the
# nip.io defaults in src/utils/api.ts and src/auth/keycloak.ts.
VITE_API_URL=https://hidris-api.tail51f978.ts.net
VITE_KEYCLOAK_URL=https://hidris-keycloak.tail51f978.ts.net
