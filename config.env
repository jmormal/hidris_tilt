# ─────────────────────────────────────────────────────────────────────────────
# Non-secret shared config. SAFE TO COMMIT.
# Loaded by the Tiltfile into a ConfigMap named "app-config" and pulled into
# pods via envFrom. One source of truth for hosts, URLs, and queue names.
#
# Rule: only values that are the SAME for every service belong here.
# Per-service values (e.g. which queue a worker drains) stay inline in the
# pod spec, NOT here.
# ─────────────────────────────────────────────────────────────────────────────

# Redis
REDIS_URL=redis://redis:6379

# Queue names (the api pushes to these; workers read one each)
QUEUE_GPU=jobs:gpu
QUEUE_CPU=jobs:cpu
# Drained by a SIF worker rather than by KEDA — a compute node, or a laptop
# running services/worker-gpu/run-local-worker.sh. Kept off jobs:gpu so it does
# not race KEDA's worker-gpu ScaledJob for the same job.
QUEUE_HPC=jobs:hpc
# Post-solve KPI computation (buildings/land-use/hazard metrics). Its own
# queue so it never races jobs:cpu/jobs:gpu, and so worker-kpi can scale
# independently of the (much heavier) ANUGA workers.
QUEUE_KPI=jobs:kpi
# RQ's own default job timeout (180s) is too short once a basin's OSM data
# isn't cached yet. Read by both the enqueuer (api, worker-gpu) and could be
# used to keep k8s/keda-kpi.yaml's activeDeadlineSeconds comfortably above it.
KPI_JOB_TIMEOUT=1200

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:80

# MinIO / S3 endpoint (the URL is not secret; the credentials are — see .env)
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# HPC login node, reached through the tailscale operator's egress proxy
# (the ExternalName Service in k8s/api.yaml). The login name is per-service and
# stays inline in the pod spec; auth is Tailscale SSH, so there is no key here.
HPC_SSH_HOST=vrhpcadm1
