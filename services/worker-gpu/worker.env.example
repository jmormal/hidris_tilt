# Copy to ~/containers/worker.env ON THE CLUSTER and chmod 600.
# Never commit the filled-in version.
#
# Passed with: singularity run --env-file worker.env ...
# Literal KEY=value only — no $VAR references, no command substitution, no quotes.

# --- Python isolation (Singularity binds the host $HOME over the container's) -
PYTHONNOUSERSITE=1
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# --- Threading / GPU --------------------------------------------------------
OMP_NUM_THREADS=1
OMP_PROC_BIND=close
OMP_PLACES=cores
NVCOMPILER_ACC_NOTIFY=0
CUDA_CACHE_PATH=/scratch/nv-cache
CUDA_CACHE_MAXSIZE=1073741824

# --- Tailscale --------------------------------------------------------------
# Same key and tag as the probe. NOT ephemeral: run-simulation.slurm keeps a
# per-node state dir, so each compute node re-registers as the same device.
TS_AUTHKEY=
TS_TAGS=tag:hpc

# --- Cluster services, over the tailnet -------------------------------------
# TAILNET names (from the tailscale.com/hostname annotations in k8s/), NOT the
# in-cluster service names. "hidris-db-rw" and "redis" resolve only inside
# Kubernetes and will fail here.
REDIS_URL=redis://hidris-redis:6379
DB_HOST=hidris-db
DB_PORT=5432
DB_NAME=hidris
PG_USER=hidris
PG_PASSWORD=

# --- ANUGA ------------------------------------------------------------------
# The 13GB ERS DEM baked into the image. Only used when a setup has no "region"
# feature — with one, tasks.py clips this DEM to that region instead.
ANUGA_ELEVATION=/app/src/MDT_malla_5m_etrs89h30.ers
ANUGA_GPU_SUBPROCESS=0
ANUGA_GPU_MODE=2
ANUGA_YIELDSTEP=20
TMPDIR=/scratch/tmp
