# Copy to ~/containers/probe.env ON THE CLUSTER and chmod 600.
# Never commit the filled-in version — it holds two live credentials.
#
# Passed with: singularity run --env-file probe.env ...
# Format is literal KEY=value. No $VAR references, no command substitution,
# no quotes (they become part of the value).

# --- Tailscale --------------------------------------------------------------
# The OAuth CLIENT SECRET on its own — the client id is not used here. Only the
# full OAuth token exchange needs the id, and that is what the k8s operator
# does; `tailscale up --authkey=` takes the secret directly.
#
#   TS_AUTHKEY=tskey-client-XXXXX?preauthorized=true
#
# Prefer the OAuth form over a plain tskey-auth-... key: auth keys expire after
# at most 90 days, and when one does, API-submitted jobs start failing
# unattended. OAuth client secrets do not expire.
#
# NOT ephemeral, deliberately. Nodes persist, and the runner keeps a per-node
# tailscaled state directory (containers/ts-state/<node>), so each compute node
# re-registers as the SAME device on every run. That is what stops the device
# list growing by one entry per Slurm job without needing ephemerality — see
# the `down` vs `logout` note in entrypoint.sh.
#
# An OAuth client MUST be scoped to a tag, and the tag must exist in the policy
# file BEFORE the client is created — a client's tags are fixed at creation, so
# adding the tag afterwards means generating a new client. tag:hpc already
# exists in this tailnet (vrhpcadm1 uses it).
#
# The policy file also needs the grant itself, which is separate from the tag:
#   { "action": "accept", "src": ["tag:hpc"], "dst": ["tag:k8s:5432,6379"] }
# hidris-db and hidris-redis are both tagged tag:k8s by the operator.
TS_AUTHKEY=
TS_TAGS=tag:hpc

# --- Targets ----------------------------------------------------------------
# TAILNET names, not in-cluster Kubernetes service names. These come from the
# tailscale.com/hostname annotations on the exposed services:
#   k8s/redis.yaml     -> hidris-redis
#   k8s/postgres.yaml  -> hidris-db
# The in-cluster names (redis, hidris-db-rw) resolve only inside the cluster
# and will fail here — the probe flags them explicitly if it sees them.
PROBE_REDIS_HOST=hidris-redis
PROBE_REDIS_PORT=6379
PROBE_DB_HOST=hidris-db
PROBE_DB_PORT=5432

# --- Database credentials ---------------------------------------------------
# The CNPG-generated application password. Read it off the cluster with:
#   kubectl get secret hidris-db-app -o jsonpath='{.data.password}' | base64 -d
DB_NAME=hidris
PG_USER=hidris
PG_PASSWORD=

# --- Optional ---------------------------------------------------------------
# TS_HOSTNAME=hidris-probe        # default: hidris-probe-$SLURM_JOB_ID
# TS_SOCKS_PORT=1055
